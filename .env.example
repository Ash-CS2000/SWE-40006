# Copy this file to .env and fill in the values.

# Port the web server listens on
PORT=3000

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/todo_app

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Version shown by /health (e.g. the Git commit SHA set by CI/CD)
APP_VERSION=dev
